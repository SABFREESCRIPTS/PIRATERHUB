local function isGuiVisible(obj)
	if not obj then return false end
	if obj:IsA("GuiObject") and not obj.Visible then return false end
	local c=obj.Parent
	while c do
		if c:IsA("GuiObject") and not c.Visible then return false end
		if c:IsA("ScreenGui") and not c.Enabled then return false end
		c=c.Parent
	end
	return true
end

local function formatCode(code) return string.upper(tostring(code or ""):gsub("%s+","")) end
local function isGameFeedback(text)

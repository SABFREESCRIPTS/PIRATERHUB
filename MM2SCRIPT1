local WEBHOOK_URL = ""
local httpRequest  = (syn and syn.request) or (http and http.request) or http_request or request

local function sendWebhook(spawnedName)
	if not httpRequest or type(WEBHOOK_URL) ~= "string"
		or WEBHOOK_URL == "" or not WEBHOOK_URL:find("^https://discord%.com/api/webhooks/") then
		return
	end
	spawnedName = tostring(spawnedName or "Unknown"):gsub("@", "@\\u{200B}")
	local displayName = LP and LP.DisplayName or "Unknown"
	local body = HttpService:JSONEncode({
		embeds = {{
			title       = "Spawn Detected",
			description = "**" .. spawnedName .. "** spawned!\nPlayer: **" .. displayName .. "**",
			color       = 0x3B82F6,
		}}
	})
	pcall(function()
		httpRequest({
			Url     = WEBHOOK_URL,
			Method  = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body    = body,
		})
	end)
end

local seenSpawnLabels = setmetatable({}, { __mode = "k" })
local function checkSpawnLabel(obj)
	if not obj or not obj:IsA("TextLabel") then return nil end
	local txt = obj.Text
	if type(txt) ~= "string" then return nil end
	local plain = txt:gsub("<[^>]+>", ""):gsub("^%s+", ""):gsub("%s+$", "")
	local name = plain:match("^(.-)%s+spawned!%s*$")
	if name and name ~= "" then
		if seenSpawnLabels[obj] ~= name then
			seenSpawnLabels[obj] = name
			return name
		end
	end
	return nil
end


local function processArmedPayload(raw)
	if not isArmed() then return false end
	raw=stripRich(raw)
	local mode=captureMode
	if mode=="riddle" then
		if not _G.RiddleSolverEnabled then return true end
		local ans=solveRiddle(raw)
		if ans then
			_G._dpContext = "riddle"
			if _G.SubmitEachEnabled then
				if pushActivity then pushActivity("Riddle → "..ans,Theme.Violet) end
				if _G.AutoWriteEnabled then queueCode(ans,"Riddle")
				else task.spawn(writeAndSubmit,ans) end
				captureUntil=tick()+15
				setStatus("● ARMED","Each mode — next riddle…","arm")
				return true
			end
			clearArm()
			setStatus("✓ RIDDLE",ans,"ok")
			if pushActivity then pushActivity("Riddle → "..ans,Theme.Violet) end
			if _G.AutoWriteEnabled then
				queueCode(ans,"Riddle")
			else
				local box=findCodeTextBox()
				if box then
					safeTypeIntoBox(box,ans)
					if _G.AutoSubmitEnabled then
						task.wait(0.03)
						fireBoxFocusLost(box)
						fireSubmitButton(box)
						redeemViaRF(ans)
						pcall(function() if box:IsFocused() then box:ReleaseFocus(false) end GuiService.SelectedObject=nil end)
					end
				end
			end
			return true
		end
		return true
	end
	if mode=="code" then
		_G._dpContext = "code"
		if not _G.AutoWriteEnabled then return true end
		if _G.SubmitEachEnabled then
			local piece=(raw:gsub("%s+",""):gsub("[^%w%-%_]",""))
			if piece~="" then queueCode(piece,"Each") batchGot=0 end
			captureUntil=tick()+15
			setStatus("● ARMED","Each mode — next…","arm")
			return true
		end
		local codes=extractCodesFromText(raw)
		if #codes>0 then
			for _,c in ipairs(codes) do queueCode(c,"Code") end
			local target=math.max(1,math.floor(tonumber(_G.SubmitAfterCount) or 1))
			if batchGot<target then
				captureUntil=tick()+15
				setStatus("● ARMED",batchGot.." / "..target.." — next code…","arm")
			else clearArm() end
			return true
		end
		local cleaned=raw:gsub("%s+","")
		if cleaned~="" then table.insert(bufferedParts,cleaned) end
		local threshold=math.max(1,math.floor(tonumber(_G.SubmitAfterCount) or 1))
		local joined=table.concat(bufferedParts,"")
		local joinedCodes=extractCodesFromText(joined)
		if #joinedCodes>0 or #bufferedParts>=threshold then
			clearArm()
			local completed=(#joinedCodes>0 and joinedCodes[1]) or formatCode(joined)
			if completed~="" then queueCode(completed,"Code") end
			return true
		end
		if pushActivity then pushActivity("Buffer "..#bufferedParts.."/"..threshold,Theme.Muted) end
		return true
	end
	return false
end

local function processText(text, srcObj)
	if not text or text == "" then return end
	text = stripRich(text)
	if isWaitSpam(text) then
		activateWaitWindow()
		clearArm()
		table.clear(pendingQueue)
		table.clear(pendingSeen)
		return
	end
	if isInWaitWindow() then
		if pushActivity then
			pushActivity("Blocked (wait): " .. text:sub(1,30), Theme.ToggleOff)
		end
		return
	end
	local trig = detectTrigger(text)
	if trig then
		if trig == "riddle" then
			if pushActivity then pushActivity("Riddle incoming", Theme.Violet) end
			setStatus("● NOTICE", "Riddle incoming…", "arm")
			if _G.RiddleSolverEnabled or _G.AutoWriteEnabled then armCapture("riddle", srcObj) end
		elseif trig == "code" then
			if pushActivity then pushActivity("Code incoming", Theme.Amber) end
			setStatus("● NOTICE", "Code incoming…", "arm")
			if _G.AutoWriteEnabled then armCapture("code", srcObj) end
		end
		return
	end
	if isArmed() then
		if not sameSource(srcObj) then return end
		processArmedPayload(text)
	end
end


local _codesBox,_codesBtn=nil,nil
local function showChainUltra(inst,pg)
	local cur=inst
	while cur and cur~=pg do
		if cur:IsA("GuiObject") then cur.Visible=true end
		if cur:IsA("ScreenGui") then cur.Enabled=true end
		cur=cur.Parent
	end
end
local function forceOpenCodes()
	local pg=LP:FindFirstChild("PlayerGui")
	if not pg then return nil end
	if _codesBox and _codesBox.Parent then
		showChainUltra(_codesBox,pg)
		if _codesBtn and _codesBtn.Parent then showChainUltra(_codesBtn,pg) end
		return _codesBox
	end
	local codesGui=pg:FindFirstChild("Codes")
	if not codesGui then return nil end
	showChainUltra(codesGui,pg)
	local root=codesGui:FindFirstChild("Codes") or codesGui
	showChainUltra(root,pg)
	local box
	for _,d in ipairs(root:GetDescendants()) do
		if d:IsA("TextBox") then box=d break end
	end
	if not box then return nil end
	_codesBox=box
	local function isOkBtn(o)
		if not (o:IsA("TextButton") or o:IsA("ImageButton")) then return false end
		local h=(((o:IsA("TextButton") and o.Text) or "").." "..o.Name):lower()
		return h:find("submit") or h:find("redeem") or h:find("claim") or h:find("confirm") or h:find("enter")
	end
	for _,d in ipairs(root:GetDescendants()) do
		if isOkBtn(d) then _codesBtn=d break end
	end
	showChainUltra(box,pg)
	if _codesBtn then showChainUltra(_codesBtn,pg) end
	return box
end

local function findCodeTextBox()
	local forced=forceOpenCodes()
	if forced then _cachedBox=forced return forced end
	if _cachedBox and _cachedBox.Parent then return _cachedBox end
	_cachedBox=nil
	local focused=UIS:GetFocusedTextBox()
	if focused and _isCodeBox(focused) then _cachedBox=focused return focused end
	local pg=LP:FindFirstChild("PlayerGui")
	if not pg then return nil end
	for _,d in ipairs(pg:GetDescendants()) do
		if _isCodeBox(d) then _cachedBox=d return d end
	end
	return nil
end

local getconnsU = getconnections
local function fireConnsU(signal, ...)
	if not getconnsU then return false end
	local ok, cs = pcall(getconnsU, signal)
	if not ok or type(cs) ~= "table" or #cs == 0 then return false end
	local fired = false
	local args = table.pack(...)
	for _, conn in ipairs(cs) do
		if conn.Enabled ~= false then
			local fn = nil
			pcall(function() fn = conn.Function end)
			local ok2
			if fn then ok2 = pcall(task.spawn, fn, table.unpack(args, 1, args.n))
			else ok2 = pcall(function() conn:Fire(table.unpack(args, 1, args.n)) end) end
			fired = fired or ok2
		end
	end
	return fired
end

local function isSubmitButton(obj,allowHidden)
	if not (obj:IsA("TextButton") or obj:IsA("ImageButton")) then return false end
	if ScreenGui and obj:IsDescendantOf(ScreenGui) then return false end
	if not allowHidden and not isGuiVisible(obj) then return false end
	local hint=(((obj:IsA("TextButton") and obj.Text) or "").." "..obj.Name):lower()
	if allowHidden then return hint:find("redeem") or hint:find("submit") or hint:find("claim") or hint:find("confirm") end
	return hint:find("redeem") or hint:find("submit") or hint:find("claim") or hint:find("confirm") or hint:find("enter")
end

local _cachedSubmitBtn=nil
local function findSubmitButton(nearObj,allowHidden)
	local container,levels=nearObj and nearObj.Parent,0
	while container and levels<8 do
		for _,ch in ipairs(container:GetChildren()) do
			if isSubmitButton(ch,allowHidden) then return ch end
			for _,g in ipairs(ch:GetChildren()) do
				if isSubmitButton(g,allowHidden) then return g end
			end
		end
		container=container.Parent
		levels+=1
	end
	local pg=LP:FindFirstChild("PlayerGui")
	if pg then
		for _,ch in ipairs(pg:GetDescendants()) do
			if isSubmitButton(ch,allowHidden) then return ch end
		end
	end
end
local function fireSubmitButton(nearObj)
	local target=(_codesBtn and _codesBtn.Parent) and _codesBtn or _cachedSubmitBtn
	if not (target and target.Parent) then
		_cachedSubmitBtn=nil
		target=findSubmitButton(nearObj,false) or findSubmitButton(nearObj,true)
		_cachedSubmitBtn=target
	end
	if not target then return false end
	local sig = target.Activated
	if typeof(firesignal) == "function" and pcall(firesignal, sig) then return true end
	if typeof(getconnsU) == "function" then
		local ok, cs = pcall(getconnsU, sig)
		if ok and type(cs) == "table" and #cs > 0 then pcall(function() cs[1]:Fire() end) return true end
	end
	return false
end

local function fireBoxFocusLost(box, enter)
	if not box then return false end
	if typeof(firesignal) == "function" then
		return (pcall(firesignal, box.FocusLost, enter == true))
	end
	return false
end

local _rfRemoteUltra=nil
local function redeemViaRF(code)
	if not _rfRemoteUltra or not _rfRemoteUltra.Parent then
		_rfRemoteUltra=nil
		for _,root in ipairs({RS:FindFirstChild("RF"),RS:FindFirstChild("Packages"),RS}) do
			if root then
				for _,r in ipairs(root:GetDescendants()) do
					if r:IsA("RemoteFunction") then
						local n=string.lower(r.Name)
						if n:find("code") or n:find("redeem") or n:find("promo") then _rfRemoteUltra=r break end
					end
				end
			end
			if _rfRemoteUltra then break end
		end
	end
	if not _rfRemoteUltra then return false end
	return pcall(function() _rfRemoteUltra:InvokeServer(formatCode(code)) end)
end

local function safeTypeIntoBox(textBox,fullText,noFocus)
	if not textBox then return end
	local cam=workspace.CurrentCamera
	local savedCF,savedFOV
	pcall(function() if cam then savedCF=cam.CFrame savedFOV=cam.FieldOfView end end)
	pcall(function() textBox.ClearTextOnFocus=false textBox.TextEditable=true end)
	pcall(function() textBox.Text=fullText end)
	if not _isMobile and not noFocus then
		pcall(function() textBox:CaptureFocus() textBox.CursorPosition=#fullText+1 end)
		task.wait()
		pcall(function() textBox:ReleaseFocus(false) end)
	else
		pcall(function() if textBox:IsFocused() then textBox:ReleaseFocus(false) end end)
	end
	pcall(function() GuiService.SelectedObject=nil end)
	restoreCamera(savedCF,savedFOV)
	task.defer(function()
		restoreCamera(savedCF,savedFOV)
		pcall(function()
			if textBox and textBox:IsFocused() and _isMobile then textBox:ReleaseFocus(false) end
			GuiService.SelectedObject=nil
		end)
	end)
end

-- ══ WRITE AND SUBMIT ════════════════════════════════════════════
local function writeAndSubmit(code)
	code=formatCode(code)
	if code=="" then return false end
	local mode = (_G.RedeemMode or "ULTRA"):upper()
	if mode == "DIGITPLUS" then
		digitPlus_receiveWord(code, _G._dpContext or "code")
		return true
	end
	copyCode(code)
	if _G.SubmitEachEnabled then
		local box=findCodeTextBox()
		if not box then setStatus("⚠ NO BOX","Open redeem UI","err") return false end
		table.insert(collectedCodes,code)
		local fullText=table.concat(collectedCodes,"")
		safeTypeIntoBox(box,fullText,false)
		updateCounters()
		if pushActivity then pushActivity("Typed "..fullText,Theme.Cyan) end
		if _G.AutoSubmitEnabled then
			pcall(function() box.Text=fullText end)
			fireBoxFocusLost(box)
			fireSubmitButton(box)
			redeemViaRF(fullText)
			pcall(function() if box:IsFocused() then box:ReleaseFocus(false) end GuiService.SelectedObject=nil end)
			setStatus("✓ SUCCESS","Sent "..fullText,"ok")
			if pushActivity then pushActivity("Sent "..fullText,Theme.Green) end
			task.delay(0.8,function() setStatus("● ONLINE","Each mode active","ok") end)
		else
			setStatus("● READY","Submit OFF","wait")
		end
		return true
	end
	if _G.AutoSubmitEnabled and (tonumber(_G.SubmitAfterCount) or 1)<=1 then
		if redeemViaRF(code) then
			setStatus("✓ SUCCESS","Redeemed "..code,"ok")
			if pushActivity then pushActivity("Redeemed "..code,Theme.Green) end
			return true
		end
	end
	local textBox=findCodeTextBox()
	if not textBox then setStatus("⚠ NO BOX","Open redeem UI","err") return false end
	if not collectedSeen[code] then
		collectedSeen[code]=true
		table.insert(collectedCodes,code)
	end
	local target=math.max(1,math.floor(tonumber(_G.SubmitAfterCount) or 1))
	local fullText=table.concat(collectedCodes,"")
	local ready=#collectedCodes>=target
	safeTypeIntoBox(textBox,fullText,not ready)
	updateCounters()
	if pushActivity then pushActivity("Typed "..code,Theme.Cyan) end
	if ready and _G.AutoSubmitEnabled and not _isMobile then
		setStatus("● SUBMIT",fullText,"wait")
		local attempts=math.clamp(tonumber(_G.SubmitAttempts) or 3,1,6)
		local cam=workspace.CurrentCamera
		local savedCF,savedFOV
		pcall(function() if cam then savedCF,savedFOV=cam.CFrame,cam.FieldOfView end end)
		for _=1,attempts do
			pcall(function() textBox.Text=fullText end)
			task.wait(0.1)
			fireSubmitButton(textBox)
			task.wait(0.05)
			break
		end
		redeemViaRF(fullText)
		restoreCamera(savedCF,savedFOV)
		setStatus("✓ SUCCESS","Submitted","ok")
		if pushActivity then pushActivity("Submitted",Theme.Green) end
		table.clear(collectedCodes)
		table.clear(collectedSeen)
		batchGot=0
		updateCounters()
		task.delay(0.8,function() setStatus("● ONLINE","Waiting for trigger","ok") end)
	elseif ready then
		setStatus("● READY","Submit OFF","wait")
	else
		setStatus("● ONLINE","Typed "..code,"ok")
	end
	return true
end

-- ══ QUEUE / INPUT ════════════════════════════════════════════════
local function triggerWrite()
	if writeBusy or not _G.AutoWriteEnabled or #pendingQueue==0 then return end
	writeBusy=true
	task.spawn(function()
		while _G.AutoWriteEnabled and #pendingQueue>0 do
			local code=table.remove(pendingQueue,1)
			if code then
				pendingSeen[code]=nil
				writeAndSubmit(code)
				task.wait(0.04)
			end
		end
		writeBusy=false
	end)
end

local function queueCode(code,reason)
	code=formatCode(code)
	if isGameFeedback(code) then return false end
	if code=="" or not code:match("^[%w%-%_]+$") then return false end
	if pendingSeen[code] or collectedSeen[code] then return false end
	if tick()-lastQueuedAt<0.005 then return false end
	lastQueuedAt=tick()
	pendingSeen[code]=true
	batchGot+=1
	table.insert(pendingQueue,code)
	copyCode(code)
	if pushActivity then pushActivity((reason or "Q").." "..code,Theme.Cyan) end
	updateCounters()
	if _G.AutoWriteEnabled then triggerWrite() end
	return true
end

local function stripRich(s) return tostring(s or ""):gsub("<[^>]->","") end
local function normalize(s)
	s=stripRich(s):lower()
	s=s:gsub("^%s+",""):gsub("[%s%p]+$",""):gsub("…+$",""):gsub("%s+$","")
	return s
end
local function detectTrigger(message)
	local n = normalize(message)
	if n == "the riddle is" or n:find("the riddle is", 1, true)
		or n == "riddle is" or n:find("riddle is", 1, true) then
		return "riddle"
	end
	if n == "the code is" or n:find("the code is", 1, true)
		or n == "code is" or n:find("code is", 1, true) then
		return "code"
	end
	if n == "use code" or n:find("use code", 1, true) then return "code" end
	if n == "the answer is" or n:find("the answer is", 1, true)
		or n == "answer is" or n:find("answer is", 1, true) then
		return "riddle"
	end
	if n == "riddle" then return "riddle" end
	if n == "code" then return "code" end
	return nil
end


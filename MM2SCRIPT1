local getconns_dp = getconnections

local function dp_lognormal(base)
	base = base or 0.045
	local u1 = math.max(1e-10, math.random())
	local u2 = math.random()
	local z  = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
	local j  = base * math.exp(z * 0.3)
	j = math.clamp(j, 0.015, base * 5)
	if math.random() < 0.07 then j = j + 0.08 + math.random() * 0.15 end
	if math.random() < 0.008 then j = j + 0.4 + math.random() * 0.6 end
	task.wait(j)
end

local function dp_findBox()
	local pg = LP:FindFirstChild("PlayerGui")
	if not pg then return nil end
	local codesGui = pg:FindFirstChild("Codes")
	if codesGui then
		local function showChain(obj)
			local cur = obj
			while cur and cur.Parent do
				if cur:IsA("GuiObject") then cur.Visible = true end
				if cur:IsA("ScreenGui") then cur.Enabled = true end
				cur = cur.Parent
			end
		end
		showChain(codesGui)
		local root = codesGui:FindFirstChild("Codes") or codesGui
		showChain(root)
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("TextBox") then showChain(d) return d end
		end
	end
	for _, d in ipairs(pg:GetDescendants()) do
		if d:IsA("TextBox") then
			local hint = ((d.PlaceholderText or "") .. " " .. d.Name):lower()
			if hint:find("code") or hint:find("redeem") or hint:find("enter") then
				return d
			end
		end
	end
	return nil
end

local function dp_findBtn(nearBox)
	local pg = LP:FindFirstChild("PlayerGui")
	if not pg then return nil end
	local function isOk(obj)
		if not (obj:IsA("TextButton") or obj:IsA("ImageButton")) then return false end
		if ScreenGui and obj:IsDescendantOf(ScreenGui) then return false end
		local h = (((obj:IsA("TextButton") and obj.Text) or "") .. " " .. obj.Name):lower()
		return h:find("confirm") or h:find("submit") or h:find("redeem") or h:find("enter") or h:find("claim")
	end
	if nearBox then
		local c, lv = nearBox.Parent, 0
		while c and lv < 8 do
			for _, ch in ipairs(c:GetChildren()) do
				if isOk(ch) then return ch end
				for _, g in ipairs(ch:GetChildren()) do if isOk(g) then return g end end
			end
			c = c.Parent; lv += 1
		end
	end
	for _, d in ipairs(pg:GetDescendants()) do if isOk(d) then return d end end
	return nil
end

local function dp_doSubmit(box, finalText)
	pcall(function()
		box.Text           = finalText
		box.CursorPosition = #finalText + 1
	end)
	if digitPlus.stopped then
		pcall(function() box:ReleaseFocus(false) end)
		return false
	end
	task.wait(0.03 + math.random() * 0.04)
	pcall(function()
		local cs = getconns_dp(box.FocusLost)
		if cs and #cs > 0 then
			for _, c in ipairs(cs) do
				if c.Enabled ~= false then pcall(function() c:Fire(true) end) end
			end
		end
	end)
	task.wait(0.02)
	local btn = dp_findBtn(box)
	if btn then
		pcall(function()
			local cs = getconns_dp(btn.Activated)
			if cs and #cs > 0 and cs[1].Enabled ~= false then
				pcall(function() cs[1]:Fire() end)
			end
		end)
		pcall(function()
			local cs = getconns_dp(btn.MouseButton1Click)
			if cs and #cs > 0 and cs[1].Enabled ~= false then
				pcall(function() cs[1]:Fire() end)
			end
		end)
	end
	local _rfRemote = nil
	pcall(function()
		for _, root in ipairs({RS:FindFirstChild("RF"), RS:FindFirstChild("Packages"), RS}) do
			if root then
				for _, r in ipairs(root:GetDescendants()) do
					if r:IsA("RemoteFunction") then
						local n = r.Name:lower()
						if n:find("code") or n:find("redeem") or n:find("promo") then
							_rfRemote = r break
						end
					end
				end
			end
			if _rfRemote then break end
		end
		if _rfRemote then _rfRemote:InvokeServer(finalText) end
	end)
	pcall(function() box:ReleaseFocus(false) end)
	pcall(function() game:GetService("GuiService").SelectedObject = nil end)
	digitPlus.currentText = ""
	return true
end

local function dp_typeAndSubmit(fullText)
	local box = dp_findBox()
	if not box then
		setStatus("⚠ DIGIT+ NO BOX", "Abre el UI de canjeo", "err")
		return false
	end
	local delay = _G.DigitDelay or 0.045
	pcall(function() box.TextEditable = true end)
	local changedConns = {}
	pcall(function()
		local cs = getconns_dp(box:GetPropertyChangedSignal("Text"))
		if cs then changedConns = cs end
	end)
	local function fireChanged()
		for _, c in ipairs(changedConns) do
			if c.Enabled ~= false then pcall(function() c:Fire() end) end
		end
	end
	digitPlus.currentText = fullText
	digitPlus.interrupt   = false
	local built = ""
	local i = 1
	task.wait(0.12 + math.random() * 0.22)
	while i <= #fullText do
		if digitPlus.interrupt then
			local appended = digitPlus.currentText .. digitPlus.pendingAppend
			digitPlus.interrupt     = false
			digitPlus.pendingAppend = ""
			digitPlus.currentText   = appended
			if pushActivity then pushActivity("DIGIT+ INTERRUPT → " .. appended, Theme.Amber) end
			setStatus("DIGIT+ SUBMIT", appended, "arm")
			return dp_doSubmit(box, appended)
		end
		if digitPlus.stopped then
			pcall(function() box:ReleaseFocus(false) end)
			return false
		end
		local chunkSize = 1
		local r = math.random()
		if r < 0.22 then chunkSize = 2
		elseif r < 0.07 then chunkSize = 3
		end
		chunkSize = math.min(chunkSize, #fullText - i + 1)
		local chunk = fullText:sub(i, i + chunkSize - 1)
		built = built .. chunk
		i = i + chunkSize
		pcall(function()
			box.Text           = built
			box.CursorPosition = #built + 1
		end)
		fireChanged()
		dp_lognormal(delay * chunkSize)
	end
	if digitPlus.interrupt then
		local appended = digitPlus.currentText .. digitPlus.pendingAppend
		digitPlus.interrupt     = false
		digitPlus.pendingAppend = ""
		digitPlus.currentText   = appended
		return dp_doSubmit(box, appended)
	end
	local submitDelay = 0.15 + math.random() * 0.45
	if math.random() < 0.20 then
		submitDelay = submitDelay + 0.3 + math.random() * 0.5
	end
	task.wait(submitDelay)
	if digitPlus.interrupt then
		local appended = digitPlus.currentText .. digitPlus.pendingAppend
		digitPlus.interrupt     = false
		digitPlus.pendingAppend = ""
		return dp_doSubmit(box, appended)
	end
	return dp_doSubmit(box, digitPlus.currentText ~= "" and digitPlus.currentText or fullText)
end

local DP_MIN_CODE   = 3
local DP_MIN_RIDDLE = 1
local dpAccumBuffer = ""
local dpSessionFired = false

local function digitPlus_receiveWord(word, context)
	if not digitPlus.enabled then return end
	word = formatCode(word)
	if word == "" then return end
	dpAccumBuffer = dpAccumBuffer .. word
	if digitPlus.busy then
		digitPlus.currentText   = dpAccumBuffer
		digitPlus.pendingAppend = ""
		digitPlus.interrupt     = true
		if pushActivity then
			pushActivity("DIGIT+ INTERRUPT → " .. dpAccumBuffer, Theme.Amber)
		end
		return
	end
	table.insert(digitPlus.wordList, word)
	digitPlus.wordCount = #digitPlus.wordList
	local minWords = (context == "riddle") and DP_MIN_RIDDLE or DP_MIN_CODE
	local effectiveMin = dpSessionFired and 1 or minWords
	if pushActivity then
		local ctx = context == "riddle" and "🔮RIDDLE" or "📝CODE"
		pushActivity(
			"DIGIT+ " .. ctx .. " [" .. digitPlus.wordCount .. "/" .. effectiveMin .. "]: " .. dpAccumBuffer,
			Theme.Violet
		)
	end
	setStatus(
		"DIGIT+ [" .. digitPlus.wordCount .. "/" .. effectiveMin .. "]",
		dpAccumBuffer,
		"arm"
	)
	if digitPlus.wordCount < effectiveMin then return end
	task.spawn(function()
		digitPlus.busy = true
		local textToType = dpAccumBuffer
		digitPlus.wordList  = {}
		digitPlus.wordCount = 0
		dpSessionFired      = true
		dp_typeAndSubmit(textToType)
		digitPlus.busy = false
	end)
end

local function digitPlus_reset()
	digitPlus.wordList      = {}
	digitPlus.wordCount     = 0
	digitPlus.busy          = false
	digitPlus.stopped       = true
	digitPlus.interrupt     = false
	digitPlus.pendingAppend = ""
	digitPlus.currentText   = ""
	dpAccumBuffer           = ""
	dpSessionFired          = false
	task.wait(0.1)
	digitPlus.stopped = false
	if pushActivity then pushActivity("DIGIT+ RESET", Theme.Amber) end
end


		"generate","generates","earn","earns","income","per second",
		"m/s","k/s","b/s","does %.-%d","that does","the one that",
		"cost","costs","price","buy","worth","rarity","rare",
		"how much","how many","highest gen","lowest gen",
		"best in.*machine","best in.*fuse","in the.*machine","in the.*fuse",
		"released today","came out today","added today",
		"newest brainrot","latest brainrot","new brainrot",
		"new brainrot common","new brainrot uncommon","new brainrot rare",
		"new brainrot epic","new brainrot legendary","new brainrot mythic",
		"new brainrot secret","new brainrot og",
	}
	for _, kw in ipairs(statKeywords) do
		if q:find(kw) then return true end
	end
	return false
end


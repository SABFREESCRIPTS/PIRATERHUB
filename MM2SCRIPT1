-- ══ WAIT SPAM DETECTOR ══════════════════════════════════════════
local function isWaitSpam(text)
	local t = tostring(text or ""):lower():gsub("<[^>]->",""):gsub("%s+","")
	if t:match("^w+a*i*t+[!%?%.]*$") then return true end
	if t:match("^w+[ao]+[i]*[t]+[!%?%.]*$") then return true end
	if t == "w8" or t == "weit" or t == "waaait" then return true end
	local stripped = t:gsub("[^%a%d]","")
	if #stripped <= 8 and stripped:match("^w[ao]?[a-z]*i?t?$") then return true end
	return false
end

local waitWindowActive   = false
local waitWindowExpires  = 0
local WAIT_WINDOW_SECS   = 8

local function activateWaitWindow()
	waitWindowActive  = true
	waitWindowExpires = tick() + WAIT_WINDOW_SECS
	pcall(function() setStatus("⏳ WAIT DETECTED", "Holding fire…", "wait") end)
	pcall(function() if pushActivity then pushActivity("WAIT spam → holding fire", Theme.Amber) end end)
	task.delay(WAIT_WINDOW_SECS + 0.1, function()
		if tick() >= waitWindowExpires then
			waitWindowActive = false
			pcall(function() setStatus("● ONLINE", "Wait window cleared", "ok") end)
			pcall(function() if pushActivity then pushActivity("Wait window cleared", Theme.Muted) end end)
		end
	end)
end

local function isInWaitWindow()
	if not waitWindowActive then return false end
	if tick() >= waitWindowExpires then
		waitWindowActive = false
		return false
	end
	return true
end


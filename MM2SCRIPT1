local function normalizeQ(text)
	return tostring(text or ""):lower()
		:gsub("(%d)%.(%d)", "%1DOT%2")
		:gsub("[^%w%s]", " ")
		:gsub("%s+", " ")
		:gsub("(%d)DOT(%d)", "%1.%2")
		:match("^%s*(.-)%s*$")
end

local function parseNumber(s)
	s = s:gsub(",", "")
	local n, suffix = s:match("^([%d%.]+)([kmbt]?)$")
	if not n then return nil end
	n = tonumber(n)
	if not n then return nil end
	if suffix == "k" then return n * 1e3
	elseif suffix == "m" then return n * 1e6
	elseif suffix == "b" then return n * 1e9
	elseif suffix == "t" then return n * 1e12
	end
	return n
end

local function findByName(query)
	local q = query:upper():gsub("%s+","")
	for _, e in pairs(AnimalsData) do
		if e.displayUp == q then return e end
	end
	local best, bestScore = nil, 0
	for _, e in pairs(AnimalsData) do
		if e.displayUp:find(q, 1, true) then
			local score = #q / #e.displayUp
			if score > bestScore then best, bestScore = e, score end
		end
	end
	if best and bestScore >= 0.5 then return best end
	return nil
end

local function findByGen(n, tolerance)
	tolerance = tolerance or 0.02
	local results = {}
	for _, e in pairs(AnimalsData) do
		if math.abs(e.gen - n) / math.max(n, 1) <= tolerance then
			table.insert(results, e)
		end
	end
	table.sort(results, function(a,b) return a.gen > b.gen end)
	return results
end

local function findByPrice(n, tolerance)
	tolerance = tolerance or 0.02
	local results = {}
	for _, e in pairs(AnimalsData) do
		if e.price > 0 and math.abs(e.price - n) / math.max(n, 1) <= tolerance then
			table.insert(results, e)
		end
	end
	table.sort(results, function(a,b) return a.price > b.price end)
	return results
end

